generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

enum StockTransactionType {
  IMPORT
  SALE
  ADJUSTMENT
  RESTORE
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum VatInvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PurchaseOrderStatus {
  COMPLETED
  CANCELLED
}

enum ReturnOrderStatus {
  COMPLETED
  CANCELLED
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}

model User {
  id           Int        @id @default(autoincrement())
  employeeCode String?    @unique
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  roleId       Int
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  role              Role               @relation(fields: [roleId], references: [id])
  orders            Order[]
  stockTransactions StockTransaction[]
  auditLogs         AuditLog[]
  shifts            Shift[]
  purchaseOrders    PurchaseOrder[]
  returnOrders      ReturnOrder[]
  notifications     Notification[]
}

model Category {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id        Int           @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String?
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id             Int           @id @default(autoincrement())
  sku            String        @unique
  name           String
  description    String?
  categoryId     Int
  supplierId     Int
  costPrice      Decimal       @db.Decimal(12, 2)
  salePrice      Decimal       @db.Decimal(12, 2)
  originalPrice  Decimal?      @db.Decimal(12, 2)
  stockQuantity  Int           @default(0)
  minStock       Int           @default(0)
  warrantyMonths Int           @default(0)
  qrCode         String?       @unique
  imageUrl       String?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id])
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  orderDetails       OrderDetail[]
  stockTransactions  StockTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  returnOrderItems   ReturnOrderItem[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  fullName  String
  phone     String   @unique
  email     String?
  address   String?
  points    Int      @default(0)
  tier      String   @default("SILVER")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders     Order[]
  warranties Warranty[]
}

model Order {
  id          Int         @id @default(autoincrement())
  orderCode   String      @unique
  userId      Int
  customerId  Int?
  totalAmount Decimal     @db.Decimal(12, 2)
  shiftId     Int?
  status      OrderStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  customer          Customer?          @relation(fields: [customerId], references: [id])
  shift             Shift?             @relation(fields: [shiftId], references: [id])
  orderDetails      OrderDetail[]
  payment           Payment?
  stockTransactions StockTransaction[]
  vatInvoiceRequest VatInvoiceRequest?
  returnOrders      ReturnOrder[]
}

model OrderDetail {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  order            Order             @relation(fields: [orderId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  warranty         Warranty?
  returnOrderItems ReturnOrderItem[]
}

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int           @unique
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  cashReceived Decimal?      @db.Decimal(12, 2)
  changeAmount Decimal?      @db.Decimal(12, 2)
  status       PaymentStatus @default(PAID)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model StockTransaction {
  id        Int                  @id @default(autoincrement())
  productId Int
  userId    Int
  orderId   Int?
  type      StockTransactionType
  quantity  Int
  note      String?
  createdAt DateTime             @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])
}

model Warranty {
  id            Int            @id @default(autoincrement())
  warrantyCode  String         @unique
  orderDetailId Int            @unique
  customerId    Int
  startDate     DateTime
  endDate       DateTime
  status        WarrantyStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entityType  String
  entityId    Int
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum PromotionDiscountType {
  AMOUNT
  PERCENT
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

model Promotion {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  discountType   PromotionDiscountType
  discountValue  Float
  minOrderAmount Float                 @default(0)
  usageLimit     Int?
  usedCount      Int                   @default(0)
  expiredAt      DateTime
  status         PromotionStatus       @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("promotions")
}

model Setting {
  id                Int      @id @default(1)
  storeName         String   @default("Homex POS")
  storeBranch       String?
  taxCode           String?
  businessHours     String?
  currency          String   @default("VND")
  storeAddress      String?
  storeHotline      String?
  printPaperSize    String   @default("K80")
  printCopies       Int      @default(1)
  autoOpenPrint     Boolean  @default(false)
  requireCustomerPhone Boolean @default(false)
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  vietQrTemplate    String?
  transferContentTemplate String?
  defaultPaymentMethod String @default("CASH")
  productsPerPage   Int      @default(24)
  autoLockMinutes   Int      @default(30)
  allowOrderDiscount Boolean @default(true)
  confirmBeforeCheckout Boolean @default(true)
  barcodeAutoAdd    Boolean  @default(true)
  compactPosMode    Boolean  @default(false)
  minStock          Int      @default(0)
  warnLowStockSale  Boolean  @default(true)
  allowOversell     Boolean  @default(false)
  maxDiscount       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VatInvoiceRequest {
  id             Int              @id @default(autoincrement())
  orderId        Int              @unique
  companyName    String
  taxCode        String
  companyAddress String
  buyerEmail     String?
  note           String?
  status         VatInvoiceStatus @default(PENDING)
  redInvoiceCode String?
  adminNote      String?
  requestedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  reviewedById   Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
}

model Shift {
  id                Int         @id @default(autoincrement())
  userId            Int
  openingCash       Decimal     @db.Decimal(12, 2)
  closingCash       Decimal?    @db.Decimal(12, 2)
  expectedCash      Decimal?    @db.Decimal(12, 2)
  discrepancyAmount Decimal?    @db.Decimal(12, 2)
  note              String?
  status            ShiftStatus @default(OPEN)
  openedAt          DateTime    @default(now())
  closedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId, status])
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  supplierId  Int
  userId      Int
  totalAmount Decimal             @db.Decimal(12, 2)
  note        String?
  status      PurchaseOrderStatus @default(COMPLETED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  user       User                @relation(fields: [userId], references: [id])
  items      PurchaseOrderItem[]
  category   Category?           @relation(fields: [categoryId], references: [id])
  categoryId Int?
}

model PurchaseOrderItem {
  id              Int      @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
}

model ReturnOrder {
  id          Int               @id @default(autoincrement())
  returnCode  String            @unique
  orderId     Int
  userId      Int
  totalAmount Decimal           @db.Decimal(12, 2)
  reason      String?
  status      ReturnOrderStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order Order             @relation(fields: [orderId], references: [id])
  user  User              @relation(fields: [userId], references: [id])
  items ReturnOrderItem[]
}

model ReturnOrderItem {
  id            Int      @id @default(autoincrement())
  returnOrderId Int
  orderDetailId Int
  productId     Int
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  lineTotal     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  returnOrder ReturnOrder @relation(fields: [returnOrderId], references: [id])
  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
}

model Notification {
  id         Int       @id @default(autoincrement())
  type       String
  title      String
  message    String
  targetRole String?
  userId     Int?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([isRead, createdAt])
}
